<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CALC + • Quick"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_theme_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Style 🎨"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Mini Screen (Tap to open full app) -->
    <LinearLayout
        android:id="@+id/btn_open_full_calc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:padding="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap for full app"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="end"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Keypad Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/btn_key_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="C"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btn_key_div"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="÷"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_mul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- Keypad Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="8"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="9"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- Keypad Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_key_eq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="="
            android:textColor="#00E5FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />
    </LinearLayout>
</LinearLayout>
