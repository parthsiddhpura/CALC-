<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CALC + • GST Tax"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_cycle_gst_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_accent_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="18% ▾"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- GST Amount Display Card (Tap to open GST Calc) -->
    <LinearLayout
        android:id="@+id/btn_open_gst_calc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/gst_base_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹25,000"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="end" />

        <TextView
            android:id="@+id/gst_rate_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GST +18%"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="4dp" />

        <TextView
            android:id="@+id/gst_total_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹29,500"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Direct + / - GST Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btn_gst_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="+ GST"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btn_gst_sub"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="- GST"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_gst_amount_inc"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="+1k"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginStart="3dp" />
    </LinearLayout>
</LinearLayout>
