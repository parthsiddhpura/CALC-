<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quick Conversion"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_toggle_unit_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Forex / Unit"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_theme_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Style 🎨"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Card Display (Tap to open in app) -->
    <LinearLayout
        android:id="@+id/btn_open_converter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:id="@+id/conv_input_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 USD"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginVertical="2dp" />

        <TextView
            android:id="@+id/conv_result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹8,730"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btn_swap_conv"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="⇄ Swap"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btn_open_app_conv"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="Convert More ↗"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
