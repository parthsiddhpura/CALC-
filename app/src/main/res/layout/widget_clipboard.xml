<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="10dp">

    <!-- Header & Copied Preview Card -->
    <LinearLayout
        android:id="@+id/btn_clipboard_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Copied Number"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipboard_val_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹25,500"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Action Buttons Row 1: Calculate, Convert, GST -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/btn_clip_calc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="Calculate"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btn_clip_convert"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="Convert"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_clip_gst"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="GST"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <!-- Action Buttons Row 2: Percentage, Save, Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_clip_pct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="Percent"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btn_clip_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="Save"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_clip_share"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="Share"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>
</LinearLayout>
