<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="10dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Values • Tap to Calc"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_theme_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Style 🎨"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Variable Item 1: Salary -->
    <LinearLayout
        android:id="@+id/btn_var_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/var_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salary"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/var_val_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹85,000"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Variable Item 2: Rent -->
    <LinearLayout
        android:id="@+id/btn_var_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/var_label_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rent"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/var_val_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹18,000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Variable Item 3: Tax -->
    <LinearLayout
        android:id="@+id/btn_var_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="3dp">

        <TextView
            android:id="@+id/var_label_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tax"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/var_val_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18%"
            android:textColor="#FFB703"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Variable Item 4: Fuel -->
    <LinearLayout
        android:id="@+id/btn_var_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/var_label_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fuel"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/var_val_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹104/L"
            android:textColor="#FF4081"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
