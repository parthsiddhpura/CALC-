<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Quick Percentage"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_theme_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Style 🎨"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Display Card (Tap to open app) -->
    <LinearLayout
        android:id="@+id/btn_open_percent_calc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:id="@+id/pct_equation_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15% of ₹8,500"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginVertical="2dp" />

        <TextView
            android:id="@+id/pct_result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹1,275"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Inline +/- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btn_pct_sub"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="-5%"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="2dp" />

        <TextView
            android:id="@+id/btn_pct_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="+5%"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_base_sub"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="-1k"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_base_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="+1k"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>
</LinearLayout>
