<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_glass"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CALC + • Loan EMI"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_theme_cycle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Style 🎨"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- EMI Display Card (Tap to open EMI loan mode) -->
    <LinearLayout
        android:id="@+id/btn_open_emi_calc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_screen_bg_glass"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/emi_principal_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹10,00,000"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/emi_terms_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="8.5% • 5 Years"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="4dp" />

        <TextView
            android:id="@+id/emi_result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹20,517 / month"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Quick Adjust Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btn_emi_tenure_sub"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="-1 Yr"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btn_emi_tenure_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="+1 Yr"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_emi_rate_sub"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_bg_glass"
            android:gravity="center"
            android:text="-0.5%"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/btn_emi_rate_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_accent_glass"
            android:gravity="center"
            android:text="+0.5%"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />
    </LinearLayout>
</LinearLayout>
